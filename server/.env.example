# jobtrack sync server configuration.
# Copy to .env and fill in. NEVER commit the filled-in .env — it is gitignored,
# and tools/guard-repo.mjs fails CI if that protection is removed.

# --- Required -------------------------------------------------------------

# Shared secret the app authenticates with. Paste the SAME value into the
# app's Settings -> Sync. Generate one:
#     openssl rand -base64 32
# The server refuses to start if this is unset or shorter than 24 characters.
#
# Still required even if you intend to sign in with Google instead (see
# below) — it stays available as a fallback credential, and the server does
# not start without it.
JOBTRACK_SYNC_TOKEN=

# Signs the OAuth state and identity cookies. Generate separately:
#     openssl rand -base64 32
JOBTRACK_SESSION_SECRET=

# The exact origin the browser app is served from — scheme + host, no
# trailing slash. Used for CORS and as the ONLY permitted post-login redirect
# target, so it must be exact.
#     e.g. https://jobs.example.com   (or http://localhost:8080 in dev)
JOBTRACK_APP_ORIGIN=http://localhost:8080

# --- Optional -------------------------------------------------------------

# Where the SQLite file lives. Inside Docker this should stay on the mounted
# volume, or your data disappears with the container.
JOBTRACK_DB_PATH=/data/jobtrack.sqlite

PORT=8787

# --- LinkedIn sign-in (optional, identity only) ---------------------------
#
# Leave all three blank to run without it; the app hides the sign-in button.
# All three must be set together or sign-in stays disabled (and says so at
# boot).
#
# This gets you the user's NAME, EMAIL and PHOTO — and nothing else.
# LinkedIn removed work history from self-serve API access in 2023, so this
# can never populate a career profile. Importing an actual work history is
# what the "Import from LinkedIn" data-export upload in the app is for.
#
# To get these:
#   1. https://www.linkedin.com/developers/apps -> Create app
#      (a LinkedIn Company Page is required; you can create one for yourself)
#   2. Products tab -> request "Sign In with LinkedIn using OpenID Connect"
#   3. Auth tab -> copy the Client ID and Client Secret
#   4. Auth tab -> Authorized redirect URLs -> add the EXACT value you set as
#      LINKEDIN_REDIRECT_URI below. LinkedIn rejects the login if it differs
#      by even a trailing slash.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://sync.example.com/auth/linkedin/callback

# --- Google sign-in (optional) — AN ALTERNATIVE TO THE SYNC TOKEN ---------
#
# Unlike LinkedIn above, signing in with Google AUTHORISES SYNC. It exists so
# you can sign in on a new device instead of copying JOBTRACK_SYNC_TOKEN
# around. Either credential works; you do not need both.
#
# GOOGLE_ALLOWED_EMAILS IS NOT OPTIONAL when the three credentials are set.
# Anyone can create a Google account, so without a list of who may sync, this
# server would accept every Google user on earth. The server REFUSES TO START
# in that state rather than coming up quietly wide open.
#
# Comma-separated, case-insensitive. Checked on every request against the
# current value, so removing an address revokes it immediately rather than
# whenever the cookie happens to expire.
#
# To get these:
#   1. https://console.cloud.google.com/apis/credentials -> Create credentials
#      -> OAuth client ID -> Web application
#   2. Authorised redirect URIs -> add the EXACT value of
#      GOOGLE_REDIRECT_URI below (Google rejects any mismatch)
#   3. Copy the Client ID and Client secret here
#
# Note: your app origin and this server may sit on different domains. The
# identity cookie is set SameSite=None; Secure so it still reaches the sync
# request in that case, which means BOTH must be served over HTTPS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sync.example.com/auth/google/callback
GOOGLE_ALLOWED_EMAILS=
